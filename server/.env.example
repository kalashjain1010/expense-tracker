# Server
PORT=8787
APP_ORIGIN=http://127.0.0.1:5173
SESSION_SECRET=change-me-to-a-long-random-string

# Google OAuth (Cloud Console → APIs & Services → Credentials)
# Enable: Google Sheets API, Google Drive API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/auth/google/callback

# Mobile OAuth (same Google Web client — add this redirect in Cloud Console)
# GOOGLE_MOBILE_REDIRECT_URI=https://trackexpense.vercel.app/auth/google/mobile/callback
# MOBILE_APP_REDIRECT=expensetracker://auth/callback

# Optional free Gemini key for SMS category suggestions
# GEMINI_API_KEY=

# Production (Vercel): Turso free DB. Leave empty locally → file: server/data/kharcha.db
# TURSO_DATABASE_URL=libsql://your-db-name-user.turso.io
# TURSO_AUTH_TOKEN=

# Optional: if set, copy this template spreadsheet instead of creating blank tabs
# TEMPLATE_SPREADSHEET_ID=
